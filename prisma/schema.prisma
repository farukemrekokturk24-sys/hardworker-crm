// Hardworker Construction — CRM & Web Sitesi veri modeli
// Geliştirme: SQLite · Yayın: PostgreSQL (provider değiştirilerek taşınır)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================================================================
// KULLANICILAR (CRM personeli)
// Roller: SUPER_ADMIN | SALES_MANAGER | AGENT | MARKETING | VIEWER
// ============================================================================

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  phone        String?
  passwordHash String
  role         String    @default("AGENT")
  avatar       String?
  active       Boolean   @default(true)
  lastLogin    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  assignedLeads   Lead[]              @relation("LeadAssignee")
  leadNotes       LeadNote[]
  leadActivities  LeadActivity[]
  statusChanges   LeadStatusHistory[]
  appointments    Appointment[]
  deals           Deal[]              @relation("DealAgent")
  tasks           Task[]              @relation("TaskAssignee")
  createdTasks    Task[]              @relation("TaskCreator")
  media           Media[]
  activityLogs    ActivityLog[]
}

// ============================================================================
// PROJELER / ENVANTER
// ============================================================================

// status: UPCOMING | ONGOING | COMPLETED
model Project {
  id            String    @id @default(cuid())
  slug          String    @unique
  name          String
  nameEn        String?
  tagline       String?
  taglineEn     String?
  descriptionTr String?
  descriptionEn String?
  status        String    @default("ONGOING")
  published     Boolean   @default(true)
  featured      Boolean   @default(false)

  city          String?
  district      String?
  address       String?
  lat           Float?
  lng           Float?
  mapsUrl       String?

  startDate     DateTime?
  deliveryDate  DateTime?
  deliveryLabel String?

  coverImage    String?
  heroImage     String?
  videoUrl      String?
  tourUrl       String?
  catalogUrl    String?
  paymentPlanUrl String?

  // Ödeme planı
  downPaymentPct   Int?
  installmentMonths Int?
  paymentTermsTr   String?
  paymentTermsEn   String?
  specialTerms     Json?   // [{ downPct, benefitTr, benefitEn }]

  features      Json?     // string[] (TR)
  featuresEn    Json?
  amenities     Json?     // [{ icon, labelTr, labelEn }]

  seoTitle      String?
  seoDescription String?

  order         Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  blocks        Block[]
  units         Unit[]
  images        ProjectImage[]
  leads         Lead[]
  appointments  Appointment[]
  deals         Deal[]
  views         UnitView[]
}

model Block {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  floors    Int?
  order     Int     @default(0)

  units     Unit[]

  @@unique([projectId, name])
}

// status: AVAILABLE | RESERVED | SOLD | BLOCKED
model Unit {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  blockId     String?
  block       Block?   @relation(fields: [blockId], references: [id], onDelete: SetNull)

  unitNo      String
  type        String            // Studio | 1+1 | 2+1 | 3+1 | 2+1 Loft
  definition  String?           // FLAT | PENTHOUSE | LOFT PENTHOUSE
  floor       String?           // Zemin Kat | 1. Kat ...
  floorNo     Int?
  grossArea   Float?            // m²
  terraceArea Float?
  gardenArea  Float?
  facing      String?           // Güney/Batı ...
  bedrooms    Int?
  bathrooms   Int?
  price       Float?
  currency    String   @default("GBP")
  status      String   @default("AVAILABLE")
  floorPlan   String?
  notes       String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  deals       Deal[]
  appointments Appointment[]
  leads       Lead[]
  views       UnitView[]

  @@unique([projectId, unitNo])
}

// category: exterior | interior | render | floorplan | siteplan | 360 | activity | progress | location
model ProjectImage {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  url       String
  category  String   @default("exterior")
  caption   String?
  alt       String?
  subGroup  String?  // "1+1", "MAYIS 2026" gibi alt kırılım
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

// ============================================================================
// LEAD / CRM
// ============================================================================

// source: PRICE_GATE | CONTACT_FORM | WHATSAPP | PHONE | INSTAGRAM | FACEBOOK | REFERRAL | WALK_IN | MANUAL
// status:  NEW | CONTACTED | QUALIFIED | VIEWING | NEGOTIATION | RESERVED | WON | LOST
model Lead {
  id        String   @id @default(cuid())
  refNo     String   @unique
  name      String
  phone     String
  email     String?
  country   String?
  language  String   @default("tr")

  source    String   @default("PRICE_GATE")
  status    String   @default("NEW")
  score     Int      @default(0)
  temp      String   @default("WARM") // HOT | WARM | COLD

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  unitId    String?
  unit      Unit?    @relation(fields: [unitId], references: [id], onDelete: SetNull)

  interestedTypes Json?   // string[] — 1+1, 2+1
  budgetMin Float?
  budgetMax Float?
  purpose   String?       // YATIRIM | OTURUM | KIRALAMA
  message   String?

  assignedToId String?
  assignedTo   User?   @relation("LeadAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)

  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  referrer    String?
  ipAddress   String?
  userAgent   String?

  consentKvkk Boolean  @default(true)
  lastActivityAt DateTime @default(now())
  convertedAt DateTime?
  deletedAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  notes         LeadNote[]
  activities    LeadActivity[]
  statusHistory LeadStatusHistory[]
  appointments  Appointment[]
  deals         Deal[]
  tasks         Task[]
  views         UnitView[]

  @@index([phone])
  @@index([status])
}

model LeadNote {
  id        String   @id @default(cuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  body      String
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now())
}

// type: CALL | WHATSAPP | EMAIL | MEETING | VIEWING | NOTE | SYSTEM
model LeadActivity {
  id        String   @id @default(cuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  type      String
  title     String
  detail    String?
  outcome   String?  // ULASILDI | ULASILAMADI | MESGUL | ILGILENMIYOR
  occurredAt DateTime @default(now())
  createdAt DateTime @default(now())
}

model LeadStatusHistory {
  id         String   @id @default(cuid())
  leadId     String
  lead       Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  fromStatus String?
  toStatus   String
  createdAt  DateTime @default(now())
}

// Ziyaretçi hangi daireye baktı — satışa sıcak sinyal
model UnitView {
  id        String   @id @default(cuid())
  leadId    String?
  lead      Lead?    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  unitId    String?
  unit      Unit?    @relation(fields: [unitId], references: [id], onDelete: Cascade)
  action    String   @default("VIEW") // VIEW | PRICE_UNLOCK | DOWNLOAD | FAVORITE
  createdAt DateTime @default(now())
}

// ============================================================================
// RANDEVU / SATIŞ
// ============================================================================

// type: VIEWING | MEETING | CALL | VIDEO_CALL
// status: SCHEDULED | CONFIRMED | COMPLETED | NO_SHOW | CANCELLED
model Appointment {
  id        String   @id @default(cuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  unitId    String?
  unit      Unit?    @relation(fields: [unitId], references: [id], onDelete: SetNull)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  type      String   @default("VIEWING")
  status    String   @default("SCHEDULED")
  startsAt  DateTime
  endsAt    DateTime?
  location  String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([startsAt])
}

// status: RESERVATION | CONTRACT | COMPLETED | CANCELLED
model Deal {
  id        String   @id @default(cuid())
  refNo     String   @unique
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  unitId    String
  unit      Unit     @relation(fields: [unitId], references: [id], onDelete: Cascade)
  agentId   String?
  agent     User?    @relation("DealAgent", fields: [agentId], references: [id], onDelete: SetNull)

  listPrice   Float
  agreedPrice Float
  currency    String  @default("GBP")
  discountPct Float?
  downPaymentPct Int?
  downPayment    Float?
  installmentMonths Int?

  status      String   @default("RESERVATION")
  reservedAt  DateTime?
  contractAt  DateTime?
  completedAt DateTime?
  cancelledAt DateTime?
  cancelReason String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  installments Installment[]
}

// status: PENDING | PARTIAL | PAID | OVERDUE
model Installment {
  id        String   @id @default(cuid())
  dealId    String
  deal      Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  no        Int
  label     String?
  dueDate   DateTime
  amount    Float
  paidAmount Float   @default(0)
  paidAt    DateTime?
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
}

model Task {
  id        String   @id @default(cuid())
  title     String
  detail    String?
  dueDate   DateTime?
  priority  String   @default("NORMAL") // LOW | NORMAL | HIGH
  done      Boolean  @default(false)
  doneAt    DateTime?

  leadId      String?
  lead        Lead?   @relation(fields: [leadId], references: [id], onDelete: Cascade)
  assignedToId String?
  assignedTo   User?  @relation("TaskAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdById  String?
  createdBy    User?  @relation("TaskCreator", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================================================
// İÇERİK / SİSTEM
// ============================================================================

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String?
  phone     String?
  subject   String?
  message   String
  handled   Boolean  @default(false)
  leadId    String?
  createdAt DateTime @default(now())
}

model Media {
  id          String   @id @default(cuid())
  url         String
  filename    String
  mimeType    String
  size        Int
  width       Int?
  height      Int?
  alt         String?
  folder      String?
  uploadedById String?
  uploadedBy   User?   @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
}

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entityId  String?
  summary   String?
  meta      Json?
  createdAt DateTime @default(now())
}
