# PostgreSQL bağlantı adresi.
# Vercel'de Neon/Supabase bağladığınızda otomatik gelir — yerelde ise
# o paneldeki "unpooled / non-pooling" adresi buraya yapıştırın.
DATABASE_URL="postgresql://kullanici:sifre@host:5432/veritabani?sslmode=require"

# Panel oturum çerezlerini imzalayan anahtar.
# Üretmek için:  openssl rand -base64 32
AUTH_SECRET="buraya-guclu-rastgele-bir-deger-yazin"

# Sitemap, robots.txt ve mutlak bağlantılar için kullanılır
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
