# Vercel'de yalnızca AUTH_SECRET'i elle girersiniz.
# DATABASE_URL, Neon/Postgres bağlandığında otomatik eklenir.
# NEXT_PUBLIC_SITE_URL gerekmez — Vercel'in alan adı otomatik kullanılır.
# ─────────────────────────────────────────────────────────────────────────────

# Panel oturum çerezlerini imzalar. ZORUNLU.
# Üretmek için:  openssl rand -base64 32
AUTH_SECRET="buraya-guclu-rastgele-bir-deger-yazin"

# PostgreSQL bağlantı adresi (Neon panelinde "pooled" KAPALI olan adres)
DATABASE_URL="postgresql://kullanici:sifre@host:5432/veritabani?sslmode=require"

# Opsiyonel — yalnızca özel alan adı kullanıyorsanız gerekir
# NEXT_PUBLIC_SITE_URL="https://hardworkercyprus.com"
