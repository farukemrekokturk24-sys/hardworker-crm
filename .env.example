# ─────────────────────────────────────────────────────────────────────────────
# Vercel'de hiçbir değişkeni elle girmenize gerek yoktur:
# DATABASE_URL, Neon/Postgres bağlandığında otomatik eklenir.
# Oturum anahtarı uygulama tarafından üretilip veritabanında saklanır.
# Aşağıdakiler yalnızca YEREL geliştirme içindir.
# ─────────────────────────────────────────────────────────────────────────────

# PostgreSQL bağlantı adresi (Neon panelinde "pooled" KAPALI olan adres)
DATABASE_URL="postgresql://kullanici:sifre@host:5432/veritabani?sslmode=require"

# Opsiyonel — anahtarı kendiniz yönetmek isterseniz (en az 16 karakter)
# AUTH_SECRET="openssl rand -base64 32 ciktisi"

# Opsiyonel — yalnızca özel alan adı kullanıyorsanız
# NEXT_PUBLIC_SITE_URL="https://hardworkercyprus.com"
